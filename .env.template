OPENCODE_API_KEY=

# Optional (defaults shown)
# LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LLM_MODEL=deepseek-v4.1-flash
# ACCESS_TOKEN=             # if set, the API needs it; open /?token=<value> once on the phone
# RATE_LIMIT_MAX=5          # summary requests per IP per window
# OCR_RATE_LIMIT_MAX=10     # photo uploads per IP per window
# RATE_LIMIT_WINDOW_S=60
# TTS_PRELOAD=1             # load the voice model at server start (0 = load on first use)
# TTS_RATE_LIMIT_MAX=20     # voice requests (sentence chunks) per IP per window
# TTS_REF_AUDIO=            # voice to clone; empty/none = off (default; ~2.4x faster on CPU), bundled = the model's clip, or a .wav path
# TTS_REF_TEXT=             # transcript of TTS_REF_AUDIO (needed with a custom clip)
# TTS_NUM_STEP=10           # Hokkien voice diffusion steps; more = slower, smoother (max 64)
